---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navbar.astro';
---

<Layout title="Fundamentos de Internet y la Web">
	<Navbar></Navbar>
	<main class="title-banner">
		<h1>Fundamentos de Internet y la Web</h1>
		<p class="mb-0">Conceptos esenciales para comprender cómo funciona la comunicación web.</p>
	</main>

	<section class="content pb-5">
		<div class="card bg-dark-subtle border-secondary-subtle mb-3">
			<div class="card-body">
				<p class="mb-0">
					Internet es una red global de redes conectadas entre sí mediante protocolos estándar.
					La World Wide Web (WWW) es un servicio que funciona sobre Internet y permite acceder a páginas y recursos mediante navegadores.
				</p>
			</div>
		</div>

		<div class="accordion" id="accordionInternetWeb">
			<div class="accordion-item">
				<h2 class="accordion-header">
					<button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#internetConceptos" aria-expanded="true" aria-controls="internetConceptos">
						Conceptos base: Internet, Web y su diferencia
					</button>
				</h2>
				<div id="internetConceptos" class="accordion-collapse collapse show" data-bs-parent="#accordionInternetWeb">
					<div class="accordion-body">
						<div class="row g-3">
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Qué es Internet</h3>
									<p class="mb-0">Infraestructura global que conecta millones de dispositivos.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Qué es la World Wide Web</h3>
									<p class="mb-0">Sistema de documentos y aplicaciones interconectadas por enlaces.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Diferencia Internet vs Web</h3>
									<p class="mb-0">Internet es la red; la Web es uno de los servicios que usa esa red.</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="accordion-item">
				<h2 class="accordion-header">
					<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#internetRed" aria-expanded="false" aria-controls="internetRed">
						Redes y comunicación
					</button>
				</h2>
				<div id="internetRed" class="accordion-collapse collapse" data-bs-parent="#accordionInternetWeb">
					<div class="accordion-body">
						<div class="row g-3">
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Modelo OSI</h3>
									<p class="mb-0">Referencia de 7 capas para entender cómo viajan los datos en una red.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Capas del modelo OSI</h3>
									<p class="mb-0">Física, Enlace, Red, Transporte, Sesión, Presentación y Aplicación.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Dirección IP</h3>
									<p class="mb-0">Identificador numérico de un dispositivo en una red.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">DNS (Domain Name System)</h3>
									<p class="mb-0">Traduce nombres de dominio (ej. ejemplo.com) a direcciones IP.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Servidores y clientes</h3>
									<p class="mb-0">El cliente solicita recursos y el servidor los procesa y responde.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Navegadores web</h3>
									<p class="mb-0">Aplicaciones cliente que interpretan HTML, CSS y JavaScript.</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="accordion-item">
				<h2 class="accordion-header">
					<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#internetProtocolos" aria-expanded="false" aria-controls="internetProtocolos">
						Peticiones web y protocolos
					</button>
				</h2>
				<div id="internetProtocolos" class="accordion-collapse collapse" data-bs-parent="#accordionInternetWeb">
					<div class="accordion-body">
						<div class="row g-3">
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Funcionamiento de una petición web</h3>
									<p class="mb-0">Navegador → DNS → servidor → respuesta.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Protocolo HTTP</h3>
									<p class="mb-0">Protocolo de transferencia de hipertexto para comunicación web.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Protocolo HTTPS</h3>
									<p class="mb-0">Versión segura de HTTP con cifrado.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Diferencia HTTP y HTTPS</h3>
									<p class="mb-0">HTTPS agrega confidencialidad, integridad y autenticación.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">SSL y TLS</h3>
									<p class="mb-0">Protocolos criptográficos; TLS es la evolución moderna de SSL.</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Métodos HTTP</h3>
									<p class="mb-0">GET (consultar), POST (crear), PUT (actualizar), DELETE (eliminar).</p>
								</div>
							</div>
							<div class="col-md-4">
								<div class="p-3 border rounded bg-body-tertiary h-100">
									<h3 class="h6">Códigos de estado HTTP</h3>
									<p class="mb-0">2xx éxito, 3xx redirección, 4xx error cliente, 5xx error servidor.</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
