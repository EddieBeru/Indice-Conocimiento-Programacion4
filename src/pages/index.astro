---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/navbar.astro";
---

<Layout title="Página de inicio">
	<Navbar />
	<main id="inicio" class="title-banner">
		<h1>Backlog para Programación 4</h1>
		<p class="mb-0">
			Resumen de los temas vistos en el curso de Programación 4 :). <br />
			Un formato simple y minimalista donde podrás explorar el desarrollo web.
		</p>
	</main>

	<section class="content pb-5">
		<div class="row g-4">
			<div class="col-md-6">
				<div class="card bg-dark-subtle border-secondary-subtle h-100">
					<div class="card-body d-flex flex-column">
						<h2 class="h4 mb-3">
							1. Fundamentos de Internet y la Web
						</h2>
						<p class="mb-4">
							Conceptos clave sobre Internet, WWW, modelo OSI, IP,
							DNS, HTTP/HTTPS, SSL/TLS, métodos HTTP y códigos de
							estado.
						</p>
						<a
							class="btn btn-outline-light mt-auto align-self-start"
							href="/internet-web.html">Ver tema</a
						>
					</div>
					<img class="grafico-card" src="/img/gatoInternet.gif" />
				</div>
			</div>
			<div class="col-md-6">
				<div class="card bg-dark-subtle border-secondary-subtle h-100">
					<div class="card-body d-flex flex-column">
						<h2 class="h4 mb-3">2. HTML</h2>
						<p class="mb-4">
							Introducción a HTML, estructura de un documento y
							etiquetas principales para construir páginas web
							correctamente.
						</p>
						<a
							class="btn btn-outline-light mt-auto align-self-start"
							href="/html.html">Ver tema</a
						>
					</div>

					<img class="grafico-card" src="/img/errorInternet.jpg" />
				</div>
			</div>
			<div class="col-md-6">
				<div class="card bg-dark-subtle border-secondary-subtle h-100">
					<div class="card-body d-flex flex-column">
						<h2 class="h4 mb-3">3. CSS</h2>
						<p class="mb-4">
							Definición de CSS, formas de aplicarlo, selectores,
							propiedades principales, box model, display,
							position, flexbox y buenas prácticas.
						</p>
						<a
							class="btn btn-outline-light mt-auto align-self-start"
							href="/css.html">Ver tema</a
						>
					</div>

					<img class="grafico-card" src="/img/gatoPintura.jpg" />
				</div>
			</div>
			<div class="col-md-6">
				<div class="card bg-dark-subtle border-secondary-subtle h-100">
					<div class="card-body d-flex flex-column">
						<h2 class="h4 mb-3">4. Elementos del Backend</h2>
						<p class="mb-4">
							Cliente/servidor, request/response HTTP, métodos
							GET/POST, Spring Boot, controladores, inyección de
							dependencias, Thymeleaf, cookies y sesiones.
						</p>
						<a
							class="btn btn-outline-light mt-auto align-self-start"
							href="/backend.html">Ver tema</a
						>
					</div>
					<img class="grafico-card" src="/img/muchasCompus.jpg" />
				</div>
			</div>
			<div class="col-md-6">
				<div class="card bg-dark-subtle border-secondary-subtle h-100">
					<div class="card-body d-flex flex-column">
						<h2 class="h4 mb-3">5. JavaScript</h2>
						<p class="mb-4">
							Descripción de distintos eventos disponibles para
							mejorar la interacción con nuestras páginas web.
						</p>
						<a
							class="btn btn-outline-light mt-auto align-self-start"
							href="/js.html">Ver tema</a
						>
					</div>
					<img class="grafico-card" src="/img/code.jpg" />
				</div>
			</div>

			<div class="col-md-6">
				<div class="card bg-dark-subtle border-secondary-subtle h-100">
					<div class="card-body d-flex flex-column">
						<h2 class="h4 mb-3">PacMan</h2>
						<p class="mb-4">
							Demostración de juegos en HTML usando a PacMan como
							referencia. Disponible en versión canvas y DOM para
							demostrar la diferencia de posibilidades entre
							ambos.
						</p>
						<div class="d-flex gap-2 mt-auto">
							<a class="btn btn-outline-light" href="/game.html">
								Canvas
							</a>
							<a class="btn btn-outline-info" href="/game-dom.html">
								DOM
							</a>
						</div>
					</div>
					<img class="grafico-card" src="/img/pacmanBug.jpg" />
				</div>
			</div>
		</div>
	</section>
</Layout>
