---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navbar.astro';
---

<Layout title="Página de inicio">
	<Navbar></Navbar>
	<main id="inicio" class="title-banner">
		<h1>Fundamentos Web para Programación 4</h1>
		<p class="mb-0">Selecciona un tema para estudiar cada bloque por separado.</p>
	</main>

	<section class="content pb-5">
		<div class="row g-4">
			<div class="col-md-6">
				<div class="card bg-dark-subtle border-secondary-subtle h-100">
					<div class="card-body d-flex flex-column">
						<h2 class="h4 mb-3">1. Fundamentos de Internet y la Web</h2>
						<p class="mb-4">
							Conceptos clave sobre Internet, WWW, modelo OSI, IP, DNS, HTTP/HTTPS, SSL/TLS,
							métodos HTTP y códigos de estado.
						</p>
						<a class="btn btn-outline-light mt-auto align-self-start" href="/internet-web">Ver tema</a>
					</div>
				</div>
			</div>
			<div class="col-md-6">
				<div class="card bg-dark-subtle border-secondary-subtle h-100">
					<div class="card-body d-flex flex-column">
						<h2 class="h4 mb-3">2. HTML</h2>
						<p class="mb-4">
							Introducción a HTML, estructura de un documento y etiquetas principales para
							construir páginas web correctamente.
						</p>
						<a class="btn btn-outline-light mt-auto align-self-start" href="/html">Ver tema</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
