---
const currentPath = Astro.url.pathname;
const getNavLinkClass = (path: string) => `nav-link ${currentPath === path ? 'active' : ''}`;
const getAriaCurrent = (path: string) => (currentPath === path ? 'page' : undefined);
---

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top border-bottom border-secondary-subtle">
  <div class="container">
    <a class="navbar-brand fw-semibold" href="/">Programación 4</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class={getNavLinkClass('/')} aria-current={getAriaCurrent('/')} href="/">Inicio</a>
        </li>
        <li class="nav-item">
          <a class={getNavLinkClass('/internet-web')} aria-current={getAriaCurrent('/internet-web')} href="/internet-web">Internet y Web</a>
        </li>
        <li class="nav-item">
          <a class={getNavLinkClass('/html')} aria-current={getAriaCurrent('/html')} href="/html">HTML</a>
        </li>
        <li class="nav-item">
          <a class={getNavLinkClass('/css')} aria-current={getAriaCurrent('/css')} href="/css">CSS</a>
        </li>
        <li class="nav-item">
          <a class={getNavLinkClass('/backend')} aria-current={getAriaCurrent('/backend')} href="/backend">Back-end</a>
        </li>
      </ul>
    </div>
  </div>
</nav>
